{
  "name": "intlstudent",
  "version": "0.1.0",
  "private": true,
  "description": "Find universities and ask questions on per-university discussion boards — built for international students.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "make-admin": "node --disable-warning=ExperimentalWarning src/make-admin.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test test/e2e/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
